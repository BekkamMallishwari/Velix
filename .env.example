# VelixAgent Environment Configuration

# Enable debug mode (true/false)
VELIX_DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
VELIX_LOG_LEVEL=WARNING

# Model Provider Configuration
VELIX_DEFAULT_PROVIDER=mock
VELIX_DEFAULT_MODEL=
VELIX_OPENAI_API_KEY=
VELIX_GEMINI_API_KEY=
VELIX_ANTHROPIC_API_KEY=
# Enable persistent command history (true/false)
# VELIX_HISTORY_ENABLED=true
